        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"date\": \"2026-09-02\",\n  \"products\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 3\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/carts/{{cartId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carts",
            "{{cartId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const cart = pm.response.json();",
              "",
              "pm.test(\"Response has id\", () => {",
              "    pm.expect(cart).to.have.property(\"id\");",
              "});",
              "",
              "pm.test(\"Response has products\", () => {",
              "    pm.expect(cart).to.have.property(\"products\");",
              "});",
              "",
              "pm.test(\"Products is an array\", () => {",
              "    pm.expect(cart.products).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
