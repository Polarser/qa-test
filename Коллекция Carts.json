          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carts",
            "{{cartId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const cart = pm.response.json();",
              "",
              "pm.test(\"Response has id\", () => {",
              "    pm.expect(cart).to.have.property(\"id\");",
              "});",
              "",
              "pm.test(\"Response has products\", () => {",
              "    pm.expect(cart).to.have.property(\"products\");",
              "});",
              "",
              "pm.test(\"Products is an array\", () => {",
              "    pm.expect(cart.products).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete cart",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/carts/{{cartId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carts",
            "{{cartId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const cart = pm.response.json();",
              "",
              "pm.test(\"Response has id\", () => {",
              "    pm.expect(cart).to.have.property(\"id\");",
              "});"
            ]
          }
        }
      ]
    }
  ]
}